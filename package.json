{
  "name": "nuget-lens",
  "displayName": "NuGet Lens",
  "description": "Extension to upgrade nuget packages from directory.packages.props, csproj or packages.config. ",
  "version": "1.0.1",
  "publisher": "RamtejDevLabs",
  "author": {
    "name": "Ramtej Sudani"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ramtejsudani/nuget-lens.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "workspaceContains:**/Directory.Packages.props",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/packages.config"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "nuget-lens.viewPackagesInCurrentFile",
        "title": "NuGet Lens: View Packages in Current File"
      },
      {
        "command": "nuget-lens.setFeedCredentials",
        "title": "NuGet Lens: Set Feed Credentials (Azure Artifacts PAT)"
      }
    ],
    "configuration": {
      "title": "NuGet Lens",
      "properties": {
        "nugetUpgrade.cacheTTL": {
          "type": "number",
          "default": 3600,
          "minimum": 0,
          "description": "How long, in seconds, to cache NuGet version/deprecation/vulnerability lookups before refetching. Set to 0 to disable caching."
        },
        "nugetUpgrade.includePrerelease": {
          "type": "boolean",
          "default": false,
          "description": "Include prerelease versions when computing upgrade recommendations."
        },
        "nugetUpgrade.feedUrl": {
          "type": "string",
          "default": "",
          "description": "Override the NuGet feed (service index URL) to check for upgrades, bypassing nuget.config resolution. Leave empty to resolve sources from nuget.config as usual."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p ./",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "fast-xml-parser": "^5.8.0"
  }
}
